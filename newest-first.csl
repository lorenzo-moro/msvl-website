<?xml version="1.0" encoding="utf-8"?>
<!-- Publication list style for the lab website: newest first, then by title. -->
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="never">
  <info>
    <title>Lab website - newest first</title>
    <id>lab-website-newest-first</id>
    <updated>2026-11-21T00:00:00+00:00</updated>
  </info>
  <macro name="author">
    <names variable="author">
      <name initialize-with=". " name-as-sort-order="all" sort-separator=", " delimiter=", " and="text" delimiter-precedes-last="contextual"/>
      <et-al font-style="italic"/>
    </names>
  </macro>
  <macro name="year">
    <date variable="issued"><date-part name="year"/></date>
  </macro>
  <macro name="container">
    <choose>
      <if type="article-journal">
        <group delimiter=", ">
          <text variable="container-title" font-style="italic"/>
          <group>
            <text variable="volume"/>
            <text variable="issue" prefix="(" suffix=")"/>
          </group>
          <text variable="page"/>
        </group>
      </if>
      <else-if type="paper-conference chapter" match="any">
        <group delimiter=", ">
          <text variable="container-title" font-style="italic" prefix="In "/>
          <text variable="publisher-place"/>
          <text variable="page"/>
        </group>
      </else-if>
      <else>
        <group delimiter=", ">
          <text variable="container-title" font-style="italic"/>
          <text variable="publisher"/>
        </group>
      </else>
    </choose>
  </macro>
  <citation>
    <layout><text macro="year"/></layout>
  </citation>
  <bibliography entry-spacing="1" hanging-indent="false">
    <sort>
      <key macro="year" sort="descending"/>
      <key variable="title"/>
    </sort>
    <layout suffix=".">
      <group delimiter=". ">
        <group delimiter=" ">
          <text macro="author"/>
          <text macro="year" prefix="(" suffix=")"/>
        </group>
        <text variable="title"/>
        <text macro="container"/>
        <text variable="note"/>
        <text variable="DOI" prefix="https://doi.org/"/>
      </group>
    </layout>
  </bibliography>
</style>
